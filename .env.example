.# Copy to .env and fill in, or export the variable directly in your shell.
# .env is gitignored. NEVER commit a real key.
#
# Register a free application at: https://www.themoviedb.org/settings/developer
# You will be shown an "API Key (v3 auth)" and an "API Read Access Token".
#
# The v4 Read Access Token is preferred. It is sent as a Bearer token and cannot
# be mistaken for a v3 key.

TMDB_API_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
